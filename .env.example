# Required: clients send this value as `Authorization: Bearer <token>`.
OPENAI_API_KEY=change-me
# Optional: accept several comma-separated tokens in addition to the key above.
# OPENAI_API_KEYS=sk-key-1,sk-key-2,sk-key-3

# -----------------------------------------------------------------------------
# Runtime defaults
# -----------------------------------------------------------------------------
# MODEL_ID=dataautogpt3/OpenDalle
# TORCH_DTYPE=bf16
# MAX_CONCURRENT=1
# PIPELINE_CLASS=auto_t2i
# DEFAULT_STEPS=20
# DEFAULT_GUIDANCE=7.0

# -----------------------------------------------------------------------------
# Model profiles — uncomment ONE complete profile
# -----------------------------------------------------------------------------

# FLUX.2 Klein 4B (complete Diffusers pipeline)
# MODEL_ID=black-forest-labs/FLUX.2-klein-4b
# PIPELINE_CLASS=flux2_klein
# FLUX2_TRANSFORMER_QUANTIZATION=none
# TORCH_DTYPE=bf16
# DEFAULT_STEPS=4
# DEFAULT_GUIDANCE=1.0

# FLUX.2 Klein 9B, quantized to FP8 while loading (H100 recommended)
# This is the supported FP8 configuration for this API.
# MODEL_ID=black-forest-labs/FLUX.2-klein-9B
# PIPELINE_CLASS=flux2_klein
# FLUX2_TRANSFORMER_QUANTIZATION=fp8
# TORCH_DTYPE=bf16
# DEFAULT_STEPS=4
# DEFAULT_GUIDANCE=1.0

# IMPORTANT: the following exact repository is a component-only, pre-quantized
# checkpoint and CANNOT be used as MODEL_ID by this Diffusers API:
# MODEL_ID=black-forest-labs/FLUX.2-klein-9b-fp8
# Use the complete 9B + FLUX2_TRANSFORMER_QUANTIZATION=fp8 profile above. This
# preserves BF16 compute for the VAE/text encoder and quantizes transformer
# weights only. An FP8-aware backend is required to consume the exact artifact.

# FLUX.2 Klein 4B with a replacement text encoder
# MODEL_ID=ponpoke/flux2-klein-4b-uncensored-text-encoder
# PIPELINE_CLASS=flux2_klein
# FLUX2_BASE_MODEL_ID=black-forest-labs/FLUX.2-klein-4B
# FLUX2_TEXT_ENCODER_SUBFOLDER=text_encoder
# FLUX2_TRANSFORMER_QUANTIZATION=none
# TORCH_DTYPE=bf16
# DEFAULT_STEPS=4
# DEFAULT_GUIDANCE=1.0

# Krea 2 Turbo
# MODEL_ID=OzzyGT/Krea_2_Turbo_nunchaku_lite_nvfp4
# PIPELINE_CLASS=auto_t2i
# FLUX2_TRANSFORMER_QUANTIZATION=none
# TORCH_DTYPE=bf16
# DEFAULT_STEPS=8
# DEFAULT_GUIDANCE=0.0

# Z-Image Turbo
# MODEL_ID=Tongyi-MAI/Z-Image-Turbo
# PIPELINE_CLASS=z_image
# FLUX2_TRANSFORMER_QUANTIZATION=none
# TORCH_DTYPE=bf16
# DEFAULT_STEPS=9
# DEFAULT_GUIDANCE=0.0

# Sana Sprint 0.6B
# MODEL_ID=Efficient-Large-Model/Sana_Sprint_0.6B_1024px_diffusers
# PIPELINE_CLASS=sana_sprint
# FLUX2_TRANSFORMER_QUANTIZATION=none
# TORCH_DTYPE=bf16
# DEFAULT_STEPS=2
# DEFAULT_GUIDANCE=0.0

# -----------------------------------------------------------------------------
# Generation defaults (used when the selected profile does not override them)
# -----------------------------------------------------------------------------
# DEFAULT_STEPS=20
# DEFAULT_GUIDANCE=7.0
# MAX_SEQUENCE_LENGTH=512

# -----------------------------------------------------------------------------
# Input guard rails
# -----------------------------------------------------------------------------
# ALLOWED_SIZES=512x512,768x768,1024x1024
# MAX_PIXELS=1048576
# REQUIRE_MULTIPLE_OF=8
# MAX_UPLOAD_BYTES=20971520

# -----------------------------------------------------------------------------
# Optional runtime features
# -----------------------------------------------------------------------------
# ENABLE_XFORMERS=0
# TORCH_COMPILE=0
# WARMUP=1

# Hugging Face downloads and cache. Leave the token empty for public models;
# gated repositories require a token accepted by Hugging Face.
# HF_TOKEN=hf_your_token
# HF_HOME=/path/to/huggingface/cache
# LOCAL_FILES_ONLY=0
# HF_HUB_ENABLE_HF_TRANSFER=1

# -----------------------------------------------------------------------------
# Idle GPU memory management (seconds)
# -----------------------------------------------------------------------------
# Set to 0 (or negative) to disable idle unload behavior.
# IDLE_UNLOAD_SECONDS=450
# IDLE_MONITOR_INTERVAL_SECONDS=30
# LOAD_PIPELINE_ON_STARTUP=0

# -----------------------------------------------------------------------------
# Network
# -----------------------------------------------------------------------------
# HOST=0.0.0.0
# PORT=8000
