# Required: clients send this value as `Authorization: Bearer <token>`.
OPENAI_API_KEY=change-me
# Optional: accept several comma-separated tokens in addition to the key above.
# OPENAI_API_KEYS=sk-key-1,sk-key-2,sk-key-3

# Model/runtime (defaults shown)
# MODEL_ID=dataautogpt3/OpenDalle
# TORCH_DTYPE=bf16
# MAX_CONCURRENT=1
# PIPELINE_CLASS=auto_t2i
# FLUX.2 Klein 4B Diffusers example:
# MODEL_ID=black-forest-labs/FLUX.2-klein-4b
# PIPELINE_CLASS=flux2_klein
# FLUX2_BASE_MODEL_ID=black-forest-labs/FLUX.2-klein-base-4B
# DEFAULT_STEPS=4
# DEFAULT_GUIDANCE=1.0
# Replacement text encoder with the non-distilled Klein base:
# MODEL_ID=ponpoke/flux2-klein-4b-uncensored-text-encoder
# PIPELINE_CLASS=flux2_klein
# FLUX2_BASE_MODEL_ID=black-forest-labs/FLUX.2-klein-base-4B
# DEFAULT_STEPS=50
# DEFAULT_GUIDANCE=4.0
# Krea 2 Turbo example:
# MODEL_ID=OzzyGT/Krea_2_Turbo_nunchaku_lite_nvfp4
# DEFAULT_STEPS=8
# DEFAULT_GUIDANCE=0.0
# Z-Image Turbo Diffusers example:
# MODEL_ID=Tongyi-MAI/Z-Image-Turbo
# PIPELINE_CLASS=z_image
# DEFAULT_STEPS=9
# DEFAULT_GUIDANCE=0.0
# Sana Sprint example (requires its explicit pipeline class):
# MODEL_ID=Efficient-Large-Model/Sana_Sprint_0.6B_1024px_diffusers
# PIPELINE_CLASS=sana_sprint
# DEFAULT_STEPS=2
# DEFAULT_GUIDANCE=0.0

# Defaults for generation
# DEFAULT_STEPS=20
# DEFAULT_GUIDANCE=7.0

# Input guard rails
# ALLOWED_SIZES=512x512,768x768,1024x1024
# MAX_PIXELS=1048576
# REQUIRE_MULTIPLE_OF=8

# Optional runtime features (defaults shown)
# ENABLE_XFORMERS=0
# TORCH_COMPILE=0
# WARMUP=1

# Idle GPU memory management (seconds)
# Set to 0 (or negative) to disable idle unload behavior.
# IDLE_UNLOAD_SECONDS=450
# IDLE_MONITOR_INTERVAL_SECONDS=30
# LOAD_PIPELINE_ON_STARTUP=0

# HOST=0.0.0.0
# PORT=8000
